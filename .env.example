MEMBRANE_WORKSPACE_KEY=your-workspace-key
MEMBRANE_WORKSPACE_SECRET=your-workspace-secret
MEMBRANE_CUSTOMER_ID=local-cli-user
MEMBRANE_CUSTOMER_NAME=Local CLI User
MEMBRANE_API_BASE_URL=https://api.getmembrane.com
# Set to true to derive snake_case keys from action names (e.g. "Create Issue" -> "create_issue").
# When unset, Membrane auto-derives the key server-side.
SNAKE_CASE_KEYS=
